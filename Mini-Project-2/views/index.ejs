<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <!-- Formatting for multiple devices -->
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meal Finder</title>
  <!-- Load the stylesheet served from the public folder. -->
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <!-- Main contains the primary content shown on this page. -->
  <main>
    <h1>Meal Finder</h1>
    <!-- GET sends the form fields in the URL to the /search route. -->
    <form action="/search" method="get">
      <label for="meal">Search for a meal</label>
      <!-- The name "meal" becomes the query parameter -->
      <input id="meal" name="meal" type="text" required>
      <!-- Submitting this button sends the form to /search. -->
      <button type="submit">Search</button>
    </form>

    <section>
      <% if (error) { %>
        <p style="color: red;"><%= error %></p>
      <% } %>
      
      <%# Show the results list when the route provides a meals value. %>
      <% if (meals) { %>
        <ul>
          <%# Render each meal's thumbnail, name, category, and area. %>
          <% meals.forEach(function(meal) { %>
            <li>
              <img src="<%= meal.strMealThumb %>" alt="<%= meal.strMeal %>" width="150">
              <h3><%= meal.strMeal %></h3>
              <p><%= meal.strCategory %> &mdash; <%= meal.strArea %></p>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>
  </main>
</body>

</html>
