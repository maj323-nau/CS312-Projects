<!-- Login Page -->
<!DOCTYPE html>
<html>
<head>
    <title>Log In</title>
</head>
<body>

    <h1>Log In</h1>

    <% if (error) { %>
        <p style="color: red;"><%= error %></p>
    <% } %>

    <form action="/login" method="POST">
        <label>Email:</label>
        <input type="text" name="email" value="<%= email %>">

        <br><br>

        <label>Password:</label>
        <input type="password" name="password">

        <br><br>

        <button type="submit">Log In</button>
    </form>

    <p>
        <a href="/">Back to Home</a>
    </p>

</body>
</html>